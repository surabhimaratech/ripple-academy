{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ripple Academy quest collection",
  "type": "object",
  "required": [
    "format",
    "version",
    "quests"
  ],
  "properties": {
    "format": {
      "const": "ripple-academy-quests"
    },
    "version": {
      "const": 1
    },
    "quests": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": [
          "title",
          "objective",
          "category",
          "xp",
          "gold"
        ],
        "not": {
          "required": [
            "completed"
          ]
        },
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "objective": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "category": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "description": {
            "type": "string",
            "maxLength": 10000
          },
          "notes": {
            "type": "string",
            "maxLength": 10000
          },
          "subtasks": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            }
          },
          "priority": {
            "enum": [
              "low",
              "normal",
              "high"
            ]
          },
          "estimatedMinutes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1440
          },
          "room": {
            "enum": [
              "personal-study",
              "grand-library",
              "observatory"
            ]
          },
          "activity": {
            "enum": [
              "system-design",
              "ai-engineering",
              "outreach",
              "reading",
              "writing",
              "stargazing",
              "astronomy-learning",
              "data-analysis",
              "scientific-programming",
              "experiment",
              "observation"
            ]
          },
          "xp": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000
          },
          "gold": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000
          },
          "courseId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        }
      }
    }
  }
}
